# Copy to `.env` for local development. The app reads no secrets from the
# environment at runtime (it is a local-first Tauri desktop app); these are
# web/dev conveniences only.
# Logging for `bun run dev` / backend `RUST_LOG` passthrough:
RUST_LOG=offering_recorder_lib=info,offering_application=info
# Vite dev-server port (matches `src-tauri/tauri.conf.json` `devUrl`):
VITE_PORT=1420
